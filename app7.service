[Unit]
Description=Flask App7 - KIT - Konstrukcja i technologia
After=network.target

[Service]
User=konrad
Group=konrad
WorkingDirectory=/home/konrad/apps/app7/kit
Environment="PATH=/home/konrad/apps/app7/kit/venv/bin"
Environment="FLASK_APP=app.py"
Environment="FLASK_ENV=production"
ExecStart=/home/konrad/apps/app7/kit/venv/bin/gunicorn -b 127.0.0.1:5007 app:app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
